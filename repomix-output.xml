}

type taskDTO struct {
	ID          int64                `json:"id"`
	Title       string               `json:"title"`
	Description string               `json:"description"`
	Status      taskdomain.Status    `json:"status"`

	RecurrenceType   *string         `json:"recurrence_type,omitempty"`
